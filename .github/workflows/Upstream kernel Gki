name: GKI 5.15 Mirror Sync

on:
  scheduled:
  workflow_dispatch:     # Bisa dijalankan manual dari tab Actions

jobs:
  mirror:
    runs-on: ubuntu-26.04
    steps:
      - name: Checkout Repository Tujuan
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Sync upstream Google Source
        env:
          UPSTREAM_URL: "https://android.googlesource.com/kernel/common"
          TARGET_BRANCH: "android13-5.15-lts"
          TARGET_REPO: "https://x-access-token:${{ secrets.GH_PAT }}@github.com/${{ github.repository }}.git"
        run: |
          git config --global user.name "GitHub Actions Bot"
          git config --global user.email "action@github.com"

          echo "::group::📥 Clone & Fetch Upstream"
          git clone --depth=1 --branch "$TARGET_BRANCH" "$UPSTREAM_URL" work_dir
          cd work_dir
          echo "::endgroup::"

          echo "::group::🚀 Push ke Repository Sendiri"
          git remote add target "$TARGET_REPO"
          git push target "HEAD:$TARGET_BRANCH" --force
          echo "::endgroup::"
